<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher: keep Sarv tokens out of backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.sarv.auth.tokens.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.sarv.auth.tokens.xml" />
    </device-transfer>
</data-extraction-rules>
