<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the library find a Custom Tabs browser on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application>
        <!-- Opens Sarv's page in a Custom Tab and hands the result back. -->
        <activity
            android:name="com.sarv.auth.AuthorizationActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Receives Sarv's redirect: <scheme>://… set by the app's
             manifestPlaceholders["sarvAuthRedirectScheme"]. -->
        <activity
            android:name="com.sarv.auth.RedirectActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${sarvAuthRedirectScheme}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
